<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.jobwarden</groupId>
		<artifactId>jobwarden</artifactId>
		<version>0.1.0</version>
	</parent>
	<artifactId>jobwarden-web</artifactId>
	<name>JobWarden :: Web</name>
	<description>Browser UI: server-rendered pages, shared layout and styles</description>

	<properties>
		<htmx.version>2.0.11</htmx.version>
		<phosphor-icons.version>2.1.2</phosphor-icons.version>
		<flag-icons.version>7.5.0</flag-icons.version>
		<frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
		<node.version>v24.21.0</node.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-common</artifactId>
		</dependency>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-identity</artifactId>
		</dependency>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-jobs</artifactId>
		</dependency>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-search</artifactId>
		</dependency>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-discover</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>htmx.org</artifactId>
			<version>${htmx.version}</version>
		</dependency>
		<!-- The icons (https://phosphoricons.com), as a font: <i class="ph ph-briefcase"></i> -->
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>phosphor-icons__web</artifactId>
			<version>${phosphor-icons.version}</version>
		</dependency>
		<!-- The flags next to each language on the settings page: <span class="fi fi-ro"></span> -->
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>flag-icons</artifactId>
			<version>${flag-icons.version}</version>
		</dependency>
		<dependency>
			<groupId>org.webjars</groupId>
			<artifactId>webjars-locator-lite</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Compiles Tailwind CSS at build time. Node is downloaded into target/, so neither
			     building nor running the app needs Node installed. -->
			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<version>${frontend-maven-plugin.version}</version>
				<configuration>
					<nodeVersion>${node.version}</nodeVersion>
					<installDirectory>target</installDirectory>
				</configuration>
				<executions>
					<execution>
						<id>install-node-and-npm</id>
						<goals>
							<goal>install-node-and-npm</goal>
						</goals>
					</execution>
					<execution>
						<id>npm-install</id>
						<goals>
							<goal>npm</goal>
						</goals>
					</execution>
					<execution>
						<id>tailwind-build</id>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>run build</arguments>
						</configuration>
					</execution>
					<!-- Not part of the build. Run `./mvnw -pl web frontend:npm@tailwind-watch`
					     to recompile the CSS whenever a template changes. -->
					<execution>
						<id>tailwind-watch</id>
						<phase>none</phase>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>run watch</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
