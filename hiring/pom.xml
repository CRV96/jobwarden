<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.jobwarden</groupId>
		<artifactId>jobwarden</artifactId>
		<version>0.1.0</version>
	</parent>
	<artifactId>jobwarden-hiring</artifactId>
	<name>JobWarden :: Hiring</name>
	<description>Who is hiring: recruiters and their posts saying they are hiring, which Claude finds on LinkedIn, X and Reddit</description>

	<dependencies>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-common</artifactId>
		</dependency>
		<!-- The contacts saved on the profile's jobs, which are recruiters too -->
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-jobs</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- @NamedInterface: marks the dto, enums, exception and service packages as the module's public API -->
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
