<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.jobwarden</groupId>
		<artifactId>jobwarden</artifactId>
		<version>0.1.0</version>
	</parent>
	<artifactId>jobwarden-app</artifactId>
	<name>JobWarden :: App</name>
	<description>Runnable Spring Boot application that wires all modules together</description>

	<properties>
		<spring-boot.run.skip>false</spring-boot.run.skip>
		<!-- The version Spring Modulith's own boundary checks use, so both read the classes the same way -->
		<archunit.version>1.4.2</archunit.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-identity</artifactId>
		</dependency>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-jobs</artifactId>
		</dependency>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-search</artifactId>
		</dependency>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-discover</artifactId>
		</dependency>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-cv</artifactId>
		</dependency>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-market</artifactId>
		</dependency>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-updates</artifactId>
		</dependency>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-hiring</artifactId>
		</dependency>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-inbox</artifactId>
		</dependency>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-watchlist</artifactId>
		</dependency>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-apply</artifactId>
		</dependency>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-capture</artifactId>
		</dependency>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-mcp</artifactId>
		</dependency>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-web</artifactId>
		</dependency>

		<!-- Health (liveness and readiness, for Docker and orchestrators) and which build is running, at /actuator -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-docker-compose</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- ConventionsTests: the rules README.md sets for the code, checked on every build -->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- META-INF/build-info.properties: the version and build time, which /actuator/info and the start-up log show -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>build-info</id>
						<goals>
							<goal>build-info</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- git.properties: the commit the jar was built from, for /actuator/info. Only what doesn't change from one
			     build of the commit to the next, so builds stay reproducible; without .git (the Docker build) it's
			     skipped. -->
			<plugin>
				<groupId>io.github.git-commit-id</groupId>
				<artifactId>git-commit-id-maven-plugin</artifactId>
				<configuration>
					<failOnNoGitDirectory>false</failOnNoGitDirectory>
					<offline>true</offline>
					<verbose>false</verbose>
					<dateFormat>yyyy-MM-dd'T'HH:mm:ssXXX</dateFormat>
					<includeOnlyProperties>
						<includeOnlyProperty>^git\.branch$</includeOnlyProperty>
						<includeOnlyProperty>^git\.commit\.id(\.abbrev)?$</includeOnlyProperty>
						<includeOnlyProperty>^git\.commit\.time$</includeOnlyProperty>
					</includeOnlyProperties>
				</configuration>
			</plugin>
			<!-- The software bill of materials (CycloneDX): every library in the jar, with its version and license, at
			     META-INF/sbom/application.cdx.json, where vulnerability scanners and /actuator/sbom find it -->
			<plugin>
				<groupId>org.cyclonedx</groupId>
				<artifactId>cyclonedx-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- What every module's tests cover, these and their own, in one report (target/site/jacoco-aggregate) -->
		<profile>
			<id>coverage</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.jacoco</groupId>
						<artifactId>jacoco-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>report-aggregate</id>
								<phase>verify</phase>
								<goals>
									<goal>report-aggregate</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
