root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,xml}]
indent_style = tab
indent_size = 4

[*.java]
# Imports: java.*, then everything else, then org.springframework.*; never wildcard imports.
ij_java_imports_layout = java.**, |, *, |, org.springframework.**, |, $*
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999

[*.{html,css,sql}]
indent_style = space
indent_size = 4

[*.{js,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
