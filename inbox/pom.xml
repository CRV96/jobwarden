<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.jobwarden</groupId>
		<artifactId>jobwarden</artifactId>
		<version>0.1.0</version>
	</parent>
	<artifactId>jobwarden-inbox</artifactId>
	<name>JobWarden :: Inbox</name>
	<description>Recruiters' emails: read from the profile's mailbox over IMAP, matched to its jobs, and offered as status changes</description>

	<dependencies>
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-common</artifactId>
		</dependency>
		<!-- The jobs the emails are about, and the timeline events they turn into -->
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-jobs</artifactId>
		</dependency>
		<!-- Asking Claude to sort the updates JobWarden couldn't match to a job -->
		<dependency>
			<groupId>com.jobwarden</groupId>
			<artifactId>jobwarden-discover</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- Jakarta Mail, for reading the mailbox over IMAP -->
		<dependency>
			<groupId>org.eclipse.angus</groupId>
			<artifactId>angus-mail</artifactId>
		</dependency>
		<!-- The text of an HTML email -->
		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
		</dependency>
		<!-- @NamedInterface: marks the dto, enums, exception and service packages as the module's public API -->
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- A real IMAP server in the tests -->
		<dependency>
			<groupId>com.icegreen</groupId>
			<artifactId>greenmail-junit5</artifactId>
			<version>${greenmail.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
