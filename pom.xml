		</license>
	</licenses>
	<developers>
		<developer>
			<id>CRV96</id>
			<name>Robert-Vasile Ciapă</name>
			<url>https://github.com/CRV96</url>
			<roles>
				<role>owner</role>
			</roles>
		</developer>
	</developers>
	<scm>
		<connection>scm:git:https://github.com/CRV96/jobwarden.git</connection>
		<developerConnection>scm:git:git@github.com:CRV96/jobwarden.git</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/CRV96/jobwarden</url>
	</scm>
