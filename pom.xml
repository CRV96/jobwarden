<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.jobwarden</groupId>
	<artifactId>jobwarden</artifactId>
	<version>0.1.0</version>
	<packaging>pom</packaging>
	<name>JobWarden</name>
	<description>Personal job application tracker with a browser extension for one-click capture</description>
	<url/>
	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/license/mit</url>
		</license>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>

	<modules>
		<module>common</module>
		<module>identity</module>
		<module>jobs</module>
		<module>search</module>
		<module>discover</module>
		<module>market</module>
		<module>cv</module>
		<module>updates</module>
		<module>hiring</module>
		<module>apply</module>
		<module>inbox</module>
		<module>watchlist</module>
		<module>capture</module>
		<module>mcp</module>
		<module>web</module>
		<module>app</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<spring-modulith.version>2.1.1</spring-modulith.version>
		<pdfbox.version>3.0.7</pdfbox.version>
		<openhtmltopdf.version>1.1.97</openhtmltopdf.version>
		<jsoup.version>1.23.2</jsoup.version>
		<greenmail.version>2.1.5</greenmail.version>
		<!-- Only the app module is runnable; lets `./mvnw -pl app -am spring-boot:run` work from the root. -->
		<spring-boot.run.skip>true</spring-boot.run.skip>
		<jacoco.version>0.8.16</jacoco.version>
		<sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>

		<!-- SonarCloud, as CI runs it after the build (.github/workflows/ci.yml) -->
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
		<sonar.organization>crv96</sonar.organization>
		<sonar.projectKey>CRV96_job_tracker</sonar.projectKey>
		<!-- What all the tests cover, in every module: most of them are the app module's, which gathers it (coverage) -->
		<sonar.coverage.jacoco.xmlReportPaths>${project.basedir}/../app/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
		<!-- The migrations are PostgreSQL's SQL, not Oracle's PL/SQL, whose rules SonarCloud would apply to them -->
		<sonar.issue.ignore.multicriteria>migrations</sonar.issue.ignore.multicriteria>
		<sonar.issue.ignore.multicriteria.migrations.ruleKey>plsql:*</sonar.issue.ignore.multicriteria.migrations.ruleKey>
		<sonar.issue.ignore.multicriteria.migrations.resourceKey>**/db/migration/*.sql</sonar.issue.ignore.multicriteria.migrations.resourceKey>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-identity</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-jobs</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-search</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-discover</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-market</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-updates</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-hiring</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-apply</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-cv</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-inbox</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-watchlist</artifactId>
				<version>${project.version}</version>
			</dependency>
			<!-- The CV: reading an uploaded PDF's text, and making a PDF from the CV page's fields -->
			<dependency>
				<groupId>org.apache.pdfbox</groupId>
				<artifactId>pdfbox</artifactId>
				<version>${pdfbox.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.openhtmltopdf</groupId>
				<artifactId>openhtmltopdf-pdfbox</artifactId>
				<version>${openhtmltopdf.version}</version>
			</dependency>
			<dependency>
				<groupId>org.jsoup</groupId>
				<artifactId>jsoup</artifactId>
				<version>${jsoup.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-capture</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-mcp</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-web</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.modulith</groupId>
				<artifactId>spring-modulith-bom</artifactId>
				<version>${spring-modulith.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>${jacoco.version}</version>
				</plugin>
				<plugin>
					<groupId>org.sonarsource.scanner.maven</groupId>
					<artifactId>sonar-maven-plugin</artifactId>
					<version>${sonar-maven-plugin.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<!-- Lombok runs as an annotation processor. Since JDK 23 processors must be listed explicitly. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- ./mvnw verify -Pcoverage: JaCoCo measures what each module's tests cover; the app module puts it together -->
		<profile>
			<id>coverage</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.jacoco</groupId>
						<artifactId>jacoco-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>prepare-agent</id>
								<goals>
									<goal>prepare-agent</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
