<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.jobwarden</groupId>
	<artifactId>jobwarden</artifactId>
	<version>0.1.0</version>
	<packaging>pom</packaging>
	<name>JobWarden</name>
	<description>Personal job application tracker with a browser extension for one-click capture</description>
	<url/>
	<licenses>
		<license>
			<name>PolyForm Shield License 1.0.0</name>
			<url>https://polyformproject.org/licenses/shield/1.0.0</url>
		</license>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>

	<modules>
		<module>common</module>
		<module>identity</module>
		<module>jobs</module>
		<module>search</module>
		<module>discover</module>
		<module>market</module>
		<module>cv</module>
		<module>updates</module>
		<module>capture</module>
		<module>mcp</module>
		<module>web</module>
		<module>app</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<spring-modulith.version>2.1.1</spring-modulith.version>
		<pdfbox.version>3.0.7</pdfbox.version>
		<openhtmltopdf.version>1.1.97</openhtmltopdf.version>
		<jsoup.version>1.23.2</jsoup.version>
		<!-- Only the app module is runnable; lets `./mvnw -pl app -am spring-boot:run` work from the root. -->
		<spring-boot.run.skip>true</spring-boot.run.skip>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-identity</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-jobs</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-search</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-discover</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-market</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-updates</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-cv</artifactId>
				<version>${project.version}</version>
			</dependency>
			<!-- The CV: reading an uploaded PDF's text, and making a PDF from the CV page's fields -->
			<dependency>
				<groupId>org.apache.pdfbox</groupId>
				<artifactId>pdfbox</artifactId>
				<version>${pdfbox.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.openhtmltopdf</groupId>
				<artifactId>openhtmltopdf-pdfbox</artifactId>
				<version>${openhtmltopdf.version}</version>
			</dependency>
			<dependency>
				<groupId>org.jsoup</groupId>
				<artifactId>jsoup</artifactId>
				<version>${jsoup.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-capture</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-mcp</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.jobwarden</groupId>
				<artifactId>jobwarden-web</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.modulith</groupId>
				<artifactId>spring-modulith-bom</artifactId>
				<version>${spring-modulith.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<!-- Lombok runs as an annotation processor. Since JDK 23 processors must be listed explicitly. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
