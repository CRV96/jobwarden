# Lombok settings for every module. Lombok looks for this file from each source file's folder upwards.
config.stopBubbling = true

# @CustomLog adds: private static final JobWardenLogger log = JobWardenLogger.of(TheClass.class);
lombok.log.custom.declaration = com.jobwarden.common.logging.JobWardenLogger.of(TYPE)

# Marks what Lombok writes with @lombok.Generated: JaCoCo leaves it out of the coverage, and NullAway out of its checks
lombok.addLombokGeneratedAnnotation = true

# @Value on a final field goes onto the constructor @RequiredArgsConstructor makes, so a setting is injected through the
# constructor like everything else: @Value("${jobwarden.mcp.path:/mcp}") private final String mcpPath;
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
